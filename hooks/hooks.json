{
  "description": "arch-slide quality gate: Claude can't finish while the latest architecture build has lint errors or no independent review.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/quality_gate.py\" 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/quality_gate.py\" 2>/dev/null || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/quality_gate.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
